# Creates the first admin account (python -m app.seed_admin) and is used to
# backfill all pre-multi-user data onto it during migration. Never commit
# real credentials — this file is just the template. Change the password
# before exposing the app anywhere (python -m app.set_admin_password later).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=changeme

# Local dev serves plain http://, and browsers never send a Secure cookie
# over http — so login needs this off locally. Leave it unset (secure is the
# default) on any HTTPS deployment. (./start.sh also sets it for you.)
SESSION_COOKIE_SECURE=false

# SQLite database path (relative to the backend/ directory when running uvicorn).
# To switch to Postgres later, replace with:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fitness
DATABASE_URL=sqlite:///./fitness.sqlite3

# Demo data: lets the admin load ~30 days of invented health data via
# POST /api/dev/seed-sample-health (tagged source='sample'). Off by default;
# never enable it on a real deployment.
# ENABLE_DEV_SEED=true

# AI features (optional). With no key, the AI report narrative and Coach
# endpoints return 503 and the rest of the app works unchanged.
# Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=
# COACH_MODEL=claude-opus-4-8
