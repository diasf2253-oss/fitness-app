# Creates the admin account (python -m app.seed_admin) and is used to
# backfill all pre-multi-user data onto it during migration. Never commit
# real credentials — this file is just the template.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=changeme

# SQLite database path (relative to the backend/ directory when running uvicorn).
# To switch to Postgres later, replace with:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fitness
DATABASE_URL=sqlite:///./fitness.sqlite3

# AI Coach (optional). With no key, the Coach shows a setup note and the rest
# of the app works unchanged. Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=
# COACH_MODEL=claude-opus-4-8
