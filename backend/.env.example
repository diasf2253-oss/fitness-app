# Bearer token used by the frontend and the Apple Health ingest endpoints.
# Change this to a long random string before exposing the API beyond localhost.
APP_TOKEN=changeme

# SQLite database path (relative to the backend/ directory when running uvicorn).
# To switch to Postgres later, replace with:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fitness
DATABASE_URL=sqlite:///./fitness.sqlite3
