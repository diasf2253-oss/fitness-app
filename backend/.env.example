# The first admin account (python -m app.cli.seed_admin), also used to backfill
# all pre-multi-user data onto it during migration. There's no admin password:
# you sign in through Supabase (below) with this same email, and the first
# sign-in links the two. seed_admin REFUSES the template address — set yours.
# Never commit real values — this file is just the template.
ADMIN_EMAIL=you@example.com

# Supabase Auth — who's signing in. Step-by-step setup: notes/runbooks/SUPABASE.md.
# Use your STAGING project here, never production.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional and server-only (never in a VITE_ variable): a secret key
# (sb_secret_…) or the legacy service_role key. Only the admin's password
# "Reset link" button needs it.
SUPABASE_SECRET_KEY=

# SQLite database path (relative to the backend/ directory when running uvicorn).
# To switch to Postgres later, replace with:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fitness
DATABASE_URL=sqlite:///./fitness.sqlite3

# Demo data: lets the admin load ~30 days of invented health data via
# POST /api/dev/seed-sample-health (tagged source='sample'). Off by default;
# never enable it on a real deployment.
# ENABLE_DEV_SEED=true

# AI features (optional). With no key, the AI report narrative and Coach
# endpoints return 503 and the rest of the app works unchanged.
# Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=
# COACH_MODEL=claude-opus-4-8
