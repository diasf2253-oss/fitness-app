# Bearer token used by the frontend and the /api/ingest/health endpoint.
# Change this to a long random string before using in production.
APP_TOKEN=changeme

# YAZIO credentials for nutrition sync.
# Fill these in yourself — never share them.
YAZIO_EMAIL=placeholder@example.com
YAZIO_PASSWORD=placeholder

# SQLite database path (relative to the backend/ directory when running uvicorn).
# To switch to Postgres later, replace with:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fitness
DATABASE_URL=sqlite:///./fitness.sqlite3
