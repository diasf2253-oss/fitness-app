# Backend settings. Copy to backend/.env (git-ignored) for local development.
# On Vercel the same names are set under Settings → Environment Variables.
# Never commit real values — this file is only the template.

# The first admin account's email. There's no admin password: you sign in
# through Supabase with this email and the first sign-in links the two.
# (python -m app.cli.seed_admin refuses this placeholder — set your own.)
ADMIN_EMAIL=you@example.com

# The app's database.
#   Local dev: a SQLite file (default below) — fast and offline.
#   Vercel:    the Supabase project's *Transaction pooler* string (port 6543).
DATABASE_URL=sqlite:///./fitness.sqlite3

# Sign-in (Supabase Auth). Supabase → Project Settings → API keys.
# Locally, use the STAGING project — never production.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional, server-only (never in a VITE_ variable): a secret key (sb_secret_…).
# Only the admin's "Reset link" button needs it.
SUPABASE_SECRET_KEY=

# --- Optional, rarely needed -------------------------------------------------
# APP_ENV=staging          # set on staging/preview deployments: shows the STAGING badge
# ENABLE_DEV_SEED=true     # local demos only: lets the admin load invented sample data
# ANTHROPIC_API_KEY=       # the (hidden) AI Coach; empty ⇒ coach endpoints answer 503
