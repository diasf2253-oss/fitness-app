# Frontend settings. Copy to frontend/.env.local (git-ignored) for local dev.
# Vite bakes these into the app, so they're PUBLIC by design — never put a
# secret key here. Locally, use the STAGING Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional, dev server only (`npm run dev`): sign in automatically as this
# STAGING Supabase login. Put these in frontend/.env.development.local, which
# Vite reads only in dev mode — so the password never reaches a build.
# VITE_DEV_AUTOLOGIN_EMAIL=demo@example.com
# VITE_DEV_AUTOLOGIN_PASSWORD=demo-password-123
