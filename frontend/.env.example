# Copy to frontend/.env.local (git-ignored) and fill in. Vite bakes these into
# the build, so they're public by design — never put a secret key here.
# Setup: notes/runbooks/SUPABASE.md. Use your STAGING project for local development.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional, dev server only (`npm run dev`): sign in automatically as this
# Supabase login while designing screens. Ignored by production builds.
# Keep these in frontend/.env.development.local.
# VITE_DEV_AUTOLOGIN_EMAIL=demo@example.com
# VITE_DEV_AUTOLOGIN_PASSWORD=demo-password-123
