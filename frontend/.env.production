# Production builds default to local-first (the phone build): the installed
# PWA reads/writes its own on-device IndexedDB and syncs opportunistically,
# so it works fully offline. iOS launches the home-screen app at "/", not
# "/?local=1", and gives it storage separate from Safari — so the runtime
# ?local=1 opt-in can't reach it; baking the default in is what makes the
# standalone app work. `npm run dev` is unaffected (stays server-mode).
VITE_LOCAL_FIRST=1
