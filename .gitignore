# ---------------------------------------------------------------------------
# Private notes — runbooks, workbooks, design/product notes, old memory.
# Kept on disk for the maintainers, never published.
# ---------------------------------------------------------------------------
notes/

# ---------------------------------------------------------------------------
# Secrets & environment
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
scripts/.env.backup

# ---------------------------------------------------------------------------
# Real personal data — NEVER commit.
# Any local DB copy may hold real data (incl. prod copies like backend/seed_db/).
# ---------------------------------------------------------------------------
*.sqlite3*
*.db
*.db-journal
**/seed_db/
*.bak*
backups/
*.dump

# Generated device-onboarding QR codes (encode a LAN/private URL)
phone-qr.*

# ---------------------------------------------------------------------------
# Build output & dependencies
# ---------------------------------------------------------------------------
# Python
.venv/
__pycache__/
*.py[cod]
.Python
*.egg-info/
.pytest_cache/
build/
# Node
node_modules/
dist/

# ---------------------------------------------------------------------------
# Tooling & editor clutter
# ---------------------------------------------------------------------------
.DS_Store
.Rhistory
# Generated code map (graphify) — regenerable, local navigation aid
graphify-out/
# Locally installed agent skills
.agents/
skills-lock.json
# Claude Code — the shared agents and slash commands are part of the repo;
# local settings, launch config, skills and agent worktrees (may contain DBs) are not.
.claude/*
!.claude/agents/
!.claude/commands/
