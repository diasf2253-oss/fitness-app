# Database connection strings for the scripts in this folder:
#   backup.sh, restore.sh, seed_staging.sh, move_to_supabase.sh
# Git-ignored. NEVER commit the real file (scripts/.env.backup).
#
# Where to find them: Supabase → your project → Connect (top bar) →
# "Session pooler". Copy that string and replace [YOUR-PASSWORD] with the
# project's database password (Project Settings → Database). Tip: if you
# reset that password, pick one with only letters and numbers — symbols
# would need escaping inside the string.

# Production Supabase project — Session pooler (port 5432).
PROD_DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Staging Supabase project (fitness-staging) — Session pooler (port 5432).
STAGING_DATABASE_URL=

# The OLD production database (from Vercel's DATABASE_URL, before the move).
# Only needed for the one-time move — delete this line about two weeks after.
OLD_DATABASE_URL=
