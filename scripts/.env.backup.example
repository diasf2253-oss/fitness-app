# Copy to scripts/.env.backup (git-ignored) and fill in.
# Used by scripts/backup.sh and scripts/restore.sh so you don't have to
# export these every shell. NEVER commit the real file.

# Production Postgres on Railway. Use the PUBLIC connection string
# (host looks like <name>.proxy.rlwy.net:PORT), not the *.railway.internal one.
PROD_DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

# Where restore.sh loads the dump. Must be localhost / 127.0.0.1 or a *staging*
# host — restore.sh refuses anything else. This default is created if missing.
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitness_local
